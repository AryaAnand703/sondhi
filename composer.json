{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "symfony/console": "^7.0",
        "symfony/error-handler": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/finder": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/mime": "^7.0",
        "symfony/process": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/string": "^7.0",
        "symfony/var-dumper": "^7.0"
    },
    "conflict": {
        "symfony/console": ">=8.0.0",
        "symfony/css-selector": ">=8.0.0",
        "symfony/error-handler": ">=8.0.0",
        "symfony/event-dispatcher": ">=8.0.0",
        "symfony/event-dispatcher-contracts": ">=8.0.0",
        "symfony/finder": ">=8.0.0",
        "symfony/http-foundation": ">=8.0.0",
        "symfony/http-kernel": ">=8.0.0",
        "symfony/mailer": ">=8.0.0",
        "symfony/mime": ">=8.0.0",
        "symfony/process": ">=8.0.0",
        "symfony/routing": ">=8.0.0",
        "symfony/serializer": ">=8.0.0",
        "symfony/service-contracts": ">=8.0.0",
        "symfony/string": ">=8.0.0",
        "symfony/translation": ">=8.0.0",
        "symfony/translation-contracts": ">=8.0.0",
        "symfony/uid": ">=8.0.0",
        "symfony/var-dumper": ">=8.0.0",
        "symfony/yaml": ">=8.0.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
